    <BehaviorTree ID="Treating" name="补血">
        
        <MultiAsyncReactiveSequence >
            
            <Treat name="补血判断"
                   subtree="{subtree}"/>
                
            <Script name="导入回家目的点" 
                            code="input_string='
                                -1.3,-4.8
                                        '"/>
            <CoverIntFromString goal_points="{goal_points}" 
                                input_string="{input_string}"/>     
            <ForceSuccess>
                <ReactiveFallback>
                    <Treatment name="回血中"/> 
                    
                    <Sequence>
