<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" >
<!--主树-->
    <BehaviorTree ID="MainTree">
        <MultiAsyncReactiveSequence name="决策循环进入点">
            <RunOnce>
                <Sequence name="初始化">
                    <Script name="初始化比赛开始"
                            code="GameStart:=false"/>
                    
                </Sequence>
            </RunOnce>
            <SetCheckHpParam    name="设置血量检查参数"
                                hp_threshold="130"
                                attack_hp_threshold="100"
                                add_to_target_hp="400"/>
            <SetStrategy name="电控通过拨杆设置比赛策略标志位"
                         choose_strategy="{choose_strategy}"/>
            <ModeBaseTripod     name="自适应小陀螺"/>

            <CheckGameStart name="比赛开始检查" 
                            Online="{Online}"
                            GameStart="{GameStart}"
                            _skipIf="GameStart"/>
            <IfGameEndThenBack name="比赛结束行为"
                            home_x="4.6"
                            home_y="8.3"
                            GameStart="{GameStart}" />
        
            <CheckWaitRespawn name="等待复活检查"/> 
            <CheckInstruction name="指令检查"
                              instruction="{instruction}"/>
            <CheckHp    name="血量检查"/>
            <CheckAmmo_C  name="弹药检查"
                          ammo_state="{ammo_state}"/>
            <CheckHit name="受击检查"/>
            <SetStyle name="设置比赛风格"/>
            <CheckRadar name="雷达目标锁定"/>
            <SetTarget  name="锁定目标"
                        ammo_state="{ammo_state}"
                        need_turn_big_yaw="{need_turn_big_yaw}"
                        have_target="{have_target}"/>
            <ScanToArea name="自适应搜寻"
                        have_target="{have_target}"/>
            <ForceSuccess>
                <Fallback>
                    <Attack name="攻击"
                            have_target="{have_target}"
                            need_turn_big_yaw="{need_turn_big_yaw}"/>
                </Fallback>
            </ForceSuccess>
<!-- ****************************************************选择器*******************************************************-->
            <Switch4 name="行为选择器"
                     variable="{choose_strategy}"  case_1="1" case_2="2" case_3="3" case_4="4" >
                
                <SubTree ID="DEFENCE"
                         have_target="{have_target}"
                         ammo_state="{ammo_state}"
                         subtree="{subtree}"/>      
                <SubTree ID="CHARGE"
                         have_target="{have_target}"
                         ammo_state="{ammo_state}"
                         subtree="{subtree}"/>        
                <SubTree ID="CHARGE_1"
                         have_target="{have_target}"
                         ammo_state="{ammo_state}"
                         subtree="{subtree}"/>  
                <SubTree ID="CHARGE_OUTPOST"
                         have_target="{have_target}"
                         ammo_state="{ammo_state}"
                         subtree="{subtree}"/>  
                <SubTree ID="CHARGE_2"
                         have_target="{have_target}"
                         ammo_state="{ammo_state}"
                         subtree="{subtree}"/>      
            </Switch4>

        </MultiAsyncReactiveSequence>   
    </BehaviorTree>

    <BehaviorTree ID="CHARGE" name="激进">
        <MultiAsyncReactiveSequence>   

            <Node_CHARGE name="激进行为"
                         have_target="{have_target}"
                         ammo_state="{ammo_state}"
                         subtree="{subtree}"/>
            <SubTree ID="ALL" 
                         subtree="{subtree}"
                         instruction="{instruction}"
                         tirpod_spin="{tirpod_spin}"
                         area_to_move="{area_to_move}"
                         have_target="{have_target}"/>  
        
        </MultiAsyncReactiveSequence>   
    </BehaviorTree>

    <BehaviorTree ID="DEFENCE" name="保守">
        <MultiAsyncReactiveSequence>   

            <Node_DEFENCE name="保守行为"
                          have_target="{have_target}"
                          ammo_state="{ammo_state}"
                          subtree="{subtree}"/>
            <SubTree ID="ALL" 
                         subtree="{subtree}"
                         have_target="{have_target}"/>  
        
        </MultiAsyncReactiveSequence>   
    </BehaviorTree>

    <BehaviorTree ID="RADAR" name="雷达">
        <MultiAsyncReactiveSequence>   

            <Node_RADAR name="雷达行为"
                         have_target="{have_target}"
                         ammo_state="{ammo_state}"
                         subtree="{subtree}"/>
            <SubTree ID="ALL" 
                         subtree="{subtree}"
                         instruction="{instruction}"
                         tirpod_spin="{tirpod_spin}"
                         area_to_move="{area_to_move}"
                         have_target="{have_target}"/>  
        
        </MultiAsyncReactiveSequence>   
    </BehaviorTree>

    <BehaviorTree ID="CHARGE_OUTPOST" name="激进_前哨">
        <MultiAsyncReactiveSequence>   

            <Node_CHARGE_OUTPOST name="激进_前哨行为"
                         have_target="{have_target}"
                         ammo_state="{ammo_state}"
                         subtree="{subtree}"/>
            <SubTree ID="ALL" 
                         subtree="{subtree}"
                         instruction="{instruction}"
                         tirpod_spin="{tirpod_spin}"
                         area_to_move="{area_to_move}"
                         have_target="{have_target}"/>  
        
        </MultiAsyncReactiveSequence>   
    </BehaviorTree>

    <BehaviorTree ID="CHARGE_1" name="激进_1">
        <MultiAsyncReactiveSequence>   

            <Node_CHARGE_1 name="激进_1_行为"
                         have_target="{have_target}"
                         ammo_state="{ammo_state}"
                         subtree="{subtree}"/>
            <SubTree ID="ALL" 
                         subtree="{subtree}"
                         instruction="{instruction}"
                         tirpod_spin="{tirpod_spin}"
                         area_to_move="{area_to_move}"
                         have_target="{have_target}"/>  
        
        </MultiAsyncReactiveSequence>   
    </BehaviorTree>

    <BehaviorTree ID="CHARGE_2" name="激进_2">
        <MultiAsyncReactiveSequence>   

            <Node_CHARGE_2 name="激进_2_行为"
                         have_target="{have_target}"
                         ammo_state="{ammo_state}"
                         subtree="{subtree}"/>
            <SubTree ID="ALL" 
                         subtree="{subtree}"
                         instruction="{instruction}"
                         tirpod_spin="{tirpod_spin}"
                         area_to_move="{area_to_move}"
                         have_target="{have_target}"/>  
        
        </MultiAsyncReactiveSequence>   
    </BehaviorTree>


<!-- ************************************************选择器***************************************************** -->
    <BehaviorTree ID="ALL" name="行为">
        <MultiAsyncReactiveSequence name="行为进入">
           <ForceSuccess>
                <SubTree ID="INSTRUCTION" 
                         subtree="{subtree}"
                         instruction="{instruction}"/>   
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="FIND_RUSH" 
                         subtree="{subtree}"
                         tirpod_spin="{tirpod_spin}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="ATTACK_OUTPOST" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="BakHome" 
                         subtree="{subtree}"
                         tirpod_spin="{tirpod_spin}"/>   
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="NO_AMMO" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="TO_FORT" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="ATTACK_RUNE" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="FIND_CENTER" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="FIND_CHARGE_1" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="FIND_CHARGE_2" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="FIND_DEFENCE" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="Treating" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="PURSUITING" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="OUT_FORBIDDEN" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="FIND_RADAR" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="FIND_STANDING" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="FIND_ALL" subtree="{subtree}"/>
            </ForceSuccess>


        </MultiAsyncReactiveSequence>
    </BehaviorTree>

<!-- ***********************************************子树******************************************************** -->
    <BehaviorTree ID="BakHome" name="回补给点">
        
        <MultiAsyncReactiveSequence name="">

            <BackHome name="回补给点判断"
                      subtree="{subtree}"/>

            <Script name="回家位置设置"
                    code="input_string='-1.3,-4.8'"/>
            <CoverIntFromString goal_points="{goal_points}" 
                                input_string="{input_string}"/>
            <MoveToPoint name="移动到补给点" 
                         goal_points="{goal_points}" />

        </MultiAsyncReactiveSequence>

    </BehaviorTree> 

    <BehaviorTree ID="OUT_FORBIDDEN" name="脱离禁区行为">
        
        <MultiAsyncReactiveSequence >

            <out_forbidden name="脱离禁区判断"
                           subtree="{subtree}"/>
            <GetOutForbidden name="禁区脱离"
                             point="{point}"/>
            <MoveToPoint name="移动到补给点" 
                         goal_points="{point}" />

        </MultiAsyncReactiveSequence>

    </BehaviorTree> 

    <BehaviorTree ID="INSTRUCTION" name="指令行为">
        
        <MultiAsyncReactiveSequence >

            <Instruction name="云台手指令判断"
                         subtree="{subtree}"
                         instruction = "{instruction}"/>
            <CoverIntFromString goal_points="{goal_points}" 
                                input_string="{instruction}"/>
            <MoveToPoint name="移动到补给点" 
                         goal_points="{goal_points}" />
        </MultiAsyncReactiveSequence>

    </BehaviorTree> 

    <BehaviorTree ID="TO_FORT" name="前往堡垒行为">
        
