            <ToFort name="前往堡垒判断"
                      subtree="{subtree}"/>

            <Script name="堡垒位置设置"
                    code="input_string='22.0,7.9'"/>
            <CoverIntFromString goal_points="{goal_points}" 
                                input_string="{input_string}"/>
            <MoveToPoint name="移动到堡垒点" 
                         goal_points="{goal_points}" />

        </MultiAsyncReactiveSequence>

    </BehaviorTree> 
        
    <BehaviorTree ID="NO_AMMO" name="无弹量行为">
        
        <MultiAsyncReactiveSequence >
 
            <NoAmmo name="无弹量判断"
                      subtree="{subtree}"/>

             <Script name="无弹量位置设置"
                    code="input_string='8.6,5.5'"/>
            <CoverIntFromString goal_points="{goal_points}" 
                                input_string="{input_string}"/>
            <MoveToPoint name="移动" 
                         goal_points="{goal_points}" />

        </MultiAsyncReactiveSequence>

    </BehaviorTree> 

    <BehaviorTree ID="ATTACK_OUTPOST" name="打前哨行为">
        
        <MultiAsyncReactiveSequence >

            <AttackOutPost  name="打前哨判断"
                             subtree="{subtree}"/>
            <Script name="导入前哨击打目的点" 
                    code="input_string='
                            16.9,7.6
                                        '"/>
            <CoverIntFromString goal_points="{goal_points}" 
                                input_string="{input_string}"/> 
            <ForceSuccess>
                <ReactiveFallback>
                    <CheckOutPost name="pitch角设置"/>
                    <Timeout name="移动超时器" msec="25000" >
                        <Sequence>
                            <MoveToPoint name="前往站桩点" 
                                        goal_points="{goal_points}"/> 
                        </Sequence> 
                    </Timeout>
                </ReactiveFallback>
            </ForceSuccess>
        </MultiAsyncReactiveSequence>

    </BehaviorTree> 



    <BehaviorTree ID="FIND_CENTER" name="中心巡逻">

        <MultiAsyncReactiveSequence >
            <Finding name="中心巡逻判断"
                     subtree="{subtree}"
                     area="FIND_CENTER"/>
            <Script name="导入目的点" 
                    code="input_string='
                            9.28,4.93,
                            8.95,10.02,
                            4.73,9.36
                                      '"/>
            <CoverIntFromString goal_points="{goal_points}" 
                                input_string="{input_string}"/> 
            <ForceSuccess>
                <Fallback> 
                    <CheckCondition name="判断是否跳过移动"
                                    value="{value}"/>
                    <Timeout name="移动超时器" msec="40000" >
                        <Sequence>
                            <MoveToPoint name="前往站桩点" 
                                        goal_points="{goal_points}"/> 
                        </Sequence> 
                    </Timeout>
                </Fallback>
            </ForceSuccess>
            <Fallback>
                
                <Sequence>
                    <Script name="跳过移动" code="value = 1"/>
                    <TimerOut time_="2500"
                              type="0"/>
                </Sequence>
                
                <Sequence>
                    <Script name="允许移动" code="value = 0"/>
                </Sequence>
            
            </Fallback>
       
        </MultiAsyncReactiveSequence>

    </BehaviorTree>


