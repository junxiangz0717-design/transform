                                     goal_points="{goal_points}"/> 
                    </Sequence> 
                </ReactiveFallback>
            </ForceSuccess>
        </MultiAsyncReactiveSequence>

    </BehaviorTree> 

    <BehaviorTree ID="PURSUITING" name="追击">
        
        <MultiAsyncReactiveSequence >
            
            <AdaptiveChoose name="追击判断"
                            subtree="{subtree}"/>
            <ForceSuccess>
                <Fallback> 
                    <CheckCondition name="判断是否跳过移动"
                                    value="{value}"/>
                    <Timeout name="移动超时器" msec="5000">
                        <Sequence>
                            <Adaptive name="自适应距离"
                                    goal_points="{goal_points}"/>
                            <MoveToPoint_pursuit name="前往站桩点" 
                                                    goal_points="{goal_points}"/> 
                        </Sequence>
                    </Timeout>
                </Fallback>
            </ForceSuccess>

            <Fallback>
                
                <Sequence>
                    <Script name="跳过移动" code="value = 1"/>
                    <TimerOut time_="500"
                              type="0"/>
                </Sequence>
                
                <Sequence>
                    <Script name="允许移动" code="value = 0"/>
                </Sequence>
            
            </Fallback>
        </MultiAsyncReactiveSequence>

