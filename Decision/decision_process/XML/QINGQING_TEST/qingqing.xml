<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" >
<!--主树-->
    <BehaviorTree ID="MainTree">
        <MultiAsyncReactiveSequence name="决策循环进入点">
            <RunOnce>
                <Sequence name="初始化">
                    <Script name="初始化比赛开始、补血状态、比赛风格、巡逻状态标志位"
                                    code="GameStart:=false"/>
                    <SetCheckHpParam    name="设置血量检查参数"
                                        hp_threshold="200"
                                        add_to_target_hp="400"/>
                </Sequence>
            </RunOnce>
             
            <SetStrategy_UL name="电控通过拨杆设置比赛策略标志位"
                                  choose_strategy="{choose_strategy}"/>
            <ModeBaseTripod     name="开关小陀螺"/>

            <CheckGameStart name="比赛开始检查" 
                            Online="{Online}"
                            GameStart="{GameStart}"
                            _skipIf="GameStart"/>
            <IfGameEndThenBack name="比赛结束行为"
                            home_x="0.0"
                            home_y="0.0"
                            GameStart="{GameStart}" />
        
            <CheckWaitRespawn name="等待复活检查"/> 
            <CheckHp    name="血量检查"/>
            <CheckHit name="受击检查"/>
            <SetTarget_QQ  name="锁定目标"
                        need_turn_big_yaw="{need_turn_big_yaw}"
                        have_target="{have_target}"/>
            <!-- <SubTree ID="PURSUITING"
                    have_target="{have_target}"
                    need_turn_big_yaw="{need_turn_big_yaw}"/> -->
                
        </MultiAsyncReactiveSequence>
    </BehaviorTree>

    <!-- 攻击测试 -->
    <BehaviorTree ID="Attack" name="攻击">
            <Attack name="攻击"
                    have_target="{have_target}"
                    need_turn_big_yaw="{need_turn_big_yaw}"/>
    </BehaviorTree>

    <!-- 发点测试 -->
    <BehaviorTree ID="GOAL_POINT" name="发点">
        <MultiAsyncReactiveSequence >
            <Script name="设置发点"
                code="input_string='11.73,7.79
                                    11.66,3.04'"/>
            <MoveToPoint name="前往发点" 
                        goal_points="{goal_points}"/>
            <CoverIntFromString goal_points="{goal_points}" 
                                input_string="{input_string}"/> 
            <ForceSuccess>
                <Fallback> 
                    <CheckCondition name="判断是否跳过移动"
                                    value="{value}"/>
                    <Timeout name="移动超时器" msec="40000" >
                        <Sequence>
                            <MoveToPoint name="前往站桩点" 
                                        goal_points="{goal_points}"/> 
                        </Sequence> 
                    </Timeout>
                </Fallback>
            </ForceSuccess>
            
            <Fallback>
                <Sequence>
                    <Script name="跳过移动" code="value = 1"/>
                    <TimerOut time_="2500"
                              type="0"/>
                </Sequence>
                
                <Sequence>
                    <Script name="允许移动" code="value = 0"/>
                </Sequence>
            </Fallback>
        </MultiAsyncReactiveSequence>
        
    </BehaviorTree>

    <!-- 追击测试 -->
    <BehaviorTree ID="PURSUITING" name="追击">
        <MultiAsyncReactiveSequence >
            <ForceSuccess>
                <Fallback> 
                    <CheckCondition name="判断是否跳过移动"
                                    value="{value}"/>
                    <Timeout name="移动超时器" msec="5000">
                        <Sequence>
                            <Adaptive_QQ name="自适应距离"
                                      goal_points="{goal_points}"/>
                            <MoveToPoint_pursuit name="前往追击点" 
                                                 goal_points="{goal_points}"/> 
                        </Sequence>
                    </Timeout>
                </Fallback>
            </ForceSuccess>

            <Fallback>
                <Sequence>
                    <Script name="跳过移动" code="value = 1"/>
                    <TimerOut time_="500"
                              type="0"/>
                </Sequence>
                
                <Sequence>
                    <Script name="允许移动" code="value = 0"/>
                </Sequence>
            </Fallback>
        </MultiAsyncReactiveSequence>
    </BehaviorTree> 
</root>
