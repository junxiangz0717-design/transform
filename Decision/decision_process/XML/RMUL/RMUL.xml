<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" >
<!--主树-->
    <BehaviorTree ID="MainTree">
        <MultiAsyncReactiveSequence name="决策循环进入点">
            <RunOnce>
                <Sequence name="初始化">
                    <Script name="初始化比赛开始、补血状态、比赛风格、巡逻状态标志位"
                            code="GameStart:=false"/>
                    <SetCheckHpParam    name="设置血量检查参数"
                                        hp_threshold="120"
                                        attack_hp_threshold="100"
                                        add_to_target_hp="400"/>
                </Sequence>
            </RunOnce>
             
            <SetStrategy_UL name="电控通过拨杆设置比赛策略标志位"
                            choose_strategy="{choose_strategy}"/>
            <ModeBaseTripod name="开关小陀螺"/>

            <CheckGameStart name="比赛开始检查" 
                            Online="{Online}"
                            GameStart="{GameStart}"
                            _skipIf="GameStart"/>
            <IfGameEndThenBack name="比赛结束行为"
                            home_x="0.0"
                            home_y="0.0"
                            GameStart="{GameStart}"/>
        
            <CheckWaitRespawn name="等待复活检查"/> 
            <CheckHp    name="血量检查"/>
            <CheckHit   name="受击检查"/>
            <CheckInCenter name="中心区检查"/>
            <SetTarget  name="锁定目标"
                        need_turn_big_yaw="{need_turn_big_yaw}"
                        have_target="{have_target}"/>
            <ForceSuccess>
                <Attack name="攻击" 
                        have_target="{have_target}"
                        need_turn_big_yaw="{need_turn_big_yaw}"/>
            </ForceSuccess>

<!-- ****************************************************策略选择*******************************************************-->
            <Switch2 name="策略选择"
                    variable="{choose_strategy}"  case_1="1" case_2="2">
                <SubTree ID="RADICAL"
                         have_target="{have_target}"
                         subtree="{subtree}"/>        
                <SubTree ID="DEFENCE"
                         have_target="{have_target}"
                         subtree="{subtree}"/>
                <!-- 默认走 DEFENCE -->
                <SubTree ID="DEFENCE"
                         have_target="{have_target}"
                         subtree="{subtree}"/>
            </Switch2>
                
        </MultiAsyncReactiveSequence>
    </BehaviorTree>

    <BehaviorTree ID="DEFENCE" name="保守">
        <MultiAsyncReactiveSequence>   
            <Node_DEFENCE name="保守打法"
                          have_target="{have_target}"
                          subtree="{subtree}"/>
            <SubTree ID="ALL" 
                         subtree="{subtree}"
                         have_target="{have_target}"/>     
        </MultiAsyncReactiveSequence>   
    </BehaviorTree>

    <BehaviorTree ID="RADICAL" name="激进">
        <MultiAsyncReactiveSequence>   
            <Node_RADICAL name="激进打法"
                         have_target="{have_target}"
                         subtree="{subtree}"/>
            <SubTree ID="ALL" 
                         subtree="{subtree}"
                         tirpod_spin="{tirpod_spin}"
                         have_target="{have_target}"/>  
        </MultiAsyncReactiveSequence>   
    </BehaviorTree>

    <!-- ************************************************选择器***************************************************** -->
    <BehaviorTree ID="ALL" name="行为">
        <MultiAsyncReactiveSequence name="行为进入">
            <ForceSuccess>
                <SubTree ID="BackHome" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="TO_CENTER" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="Treating" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="FIND_CHARGE" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="FIND_DEFENCE" subtree="{subtree}"/>
            </ForceSuccess>

            <ForceSuccess>
                <SubTree ID="PURSUITING" subtree="{subtree}"/>
            </ForceSuccess>
        </MultiAsyncReactiveSequence>
    </BehaviorTree>

<!-- ***********************************************子树******************************************************** -->
    <BehaviorTree ID="BackHome" name="回补给点">
        <MultiAsyncReactiveSequence>
            <BackHome name="回补给点判断"
                      subtree="{subtree}"/>

            <Script name="回家位置设置"
                    code="input_string='0.49,-0.52'"/>
            <CoverIntFromString goal_points="{goal_points}" 
                                input_string="{input_string}"/>
            <MoveToPoint name="移动到补给点" 
                         goal_points="{goal_points}" />

        </MultiAsyncReactiveSequence>
    </BehaviorTree>     

    <BehaviorTree ID="TO_CENTER" name="前往中心点行为">
        <MultiAsyncReactiveSequence >
            <ToCenter name="前往中心点判断"
                      subtree="{subtree}"/>

            <Script name="中心点位置设置"
                    code="input_string='5.9,-4.0'"/>
            <CoverIntFromString goal_points="{goal_points}" 
                                input_string="{input_string}"/>
            <MoveToPoint name="移动到中心点" 
                         goal_points="{goal_points}" />
        </MultiAsyncReactiveSequence>
    </BehaviorTree>

    <BehaviorTree ID="FIND_DEFENCE" name="保守行为">
        <MultiAsyncReactiveSequence >
            <Finding name="保守站桩判断"
                     subtree="{subtree}"
                     area="FIND_DEFENCE"/>
            <Script name="导入目的点" 
                    code="input_string='5.99,-0.82'"/>
            <CoverIntFromString goal_points="{goal_points}" 
                                input_string="{input_string}"/> 
            <ForceSuccess>
                <Fallback> 
                    <CheckCondition name="判断是否跳过移动"
                                    value="{value}"/>
                    <Timeout name="移动超时器" msec="40000" >
                        <Sequence>
                            <MoveToPoint name="前往站桩点" 
                                        goal_points="{goal_points}"/> 
                        </Sequence> 
                    </Timeout>
                </Fallback>
            </ForceSuccess>
            
            <Fallback>
                <Sequence>
                    <Script name="跳过移动" code="value = 1"/>
                    <TimerOut time_="3000"
                              type="0"/>
                </Sequence>
                
                <Sequence>
                    <Script name="允许移动" code="value = 0"/>
                </Sequence>
            </Fallback>
        </MultiAsyncReactiveSequence>
    </BehaviorTree>

    <BehaviorTree ID="FIND_CHARGE" name="敌人家巡逻">
        <MultiAsyncReactiveSequence >
            <Finding name="U型巡逻判断"
                     subtree="{subtree}"
                     area="FIND_CHARGE"/>
           <Script name="导入目的点" 
                    code="input_string='
                            5.94, -2.72,
                            9.72, -0.89'"/>
            <CoverIntFromString goal_points="{goal_points}" 
                                input_string="{input_string}"/> 
            <ForceSuccess>
                <Fallback> 
                    <CheckCondition name="判断是否跳过移动"
                                    value="{value}"/>
                    <Timeout name="移动超时器" msec="40000" >
                        <Sequence>
                            <MoveToPoint name="前往站桩点" 
                                        goal_points="{goal_points}"/> 
                        </Sequence> 
                    </Timeout>
                </Fallback>
            </ForceSuccess>
            
            <Fallback>
                <Sequence>
                    <Script name="跳过移动" code="value = 1"/>
                    <TimerOut time_="2500"
                              type="0"/>
                </Sequence>
                
                <Sequence>
                    <Script name="允许移动" code="value = 0"/>
                </Sequence>
            </Fallback>
        </MultiAsyncReactiveSequence>
    </BehaviorTree>

    <BehaviorTree ID="Treating" name="补血">
        <MultiAsyncReactiveSequence >
            <Treat name="补血判断"
                   subtree="{subtree}"/>

            <Script name="导入回家目的点" 
                    code="input_string='0.49,-0.52'"/>
            <CoverIntFromString goal_points="{goal_points}" 
                                input_string="{input_string}"/>   

            <ForceSuccess>
                <ReactiveFallback>
                    <Treatment name="回血中"/> 
                    
                    <Sequence>
                        <MoveToPoint name="前往回家点" 
                                     goal_points="{goal_points}"/> 
                    </Sequence> 
                </ReactiveFallback>
            </ForceSuccess>
        </MultiAsyncReactiveSequence>
    </BehaviorTree>

    <BehaviorTree ID="PURSUITING" name="追击">
        <MultiAsyncReactiveSequence >
            <AdaptiveChoose name="追击判断"
                            subtree="{subtree}"/>
            <ForceSuccess>
                <Fallback> 
                    <CheckCondition name="判断是否跳过移动"
                                    value="{value}"/>
                    <Timeout name="移动超时器" msec="5000">
                        <Sequence>
                            <Adaptive name="自适应距离"
                                      goal_points="{goal_points}"/>
                            <MoveToPoint_pursuit name="前往追击点" 
                                                 goal_points="{goal_points}"/> 
                        </Sequence>
                    </Timeout>
                </Fallback>
            </ForceSuccess>

            <Fallback>
                <Sequence>
                    <Script name="跳过移动" code="value = 1"/>
                    <TimerOut time_="500"
                              type="0"/>
                </Sequence>
                
                <Sequence>
                    <Script name="允许移动" code="value = 0"/>
                </Sequence>
            </Fallback>
        </MultiAsyncReactiveSequence>
    </BehaviorTree> 
<!-- ***********************************************子树******************************************************** -->

</root>
